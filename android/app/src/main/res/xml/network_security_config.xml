<?xml version="1.0" encoding="utf-8"?>
<!-- Everything stays HTTPS (the computer's link is TLS with a pinned certificate), except the usual home addresses of a
     router: "Turn on computer" asks the Keenetic router there over plain HTTP, as its own web page does. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">my.keenetic.net</domain>
    </domain-config>
</network-security-config>
