    },
    "No account, no analytics, no ads. Your sessions travel through your own private iCloud, encrypted with your keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта, аналитики и рекламы. Ваши сессии идут через ваш личный iCloud, зашифрованные вашими ключами."
          }
        }
      }
    },
    "No answer from the computer. Same Wi-Fi? Is it awake?": {
      "localizations": {
